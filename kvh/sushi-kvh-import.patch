From 8ba6951c75076c3d7ce649d585cdd5d32d3d98d7 Mon Sep 17 00:00:00 2001
From: kvh <kvh@localhost>
Date: Wed, 7 Oct 2026 17:05:32 +0800
Subject: [PATCH] KVH (local patch): POST /v1/kvh/import indexes an SSD-tier
 entry written while the server runs

---
 src/kv_disk_cache.zig | 41 +++++++++++++++++++++++++++++++++++++++++
 src/prefix_cache.zig  |  3 +++
 src/server.zig        | 23 +++++++++++++++++++++++
 3 files changed, 67 insertions(+)

diff --git a/src/kv_disk_cache.zig b/src/kv_disk_cache.zig
index 740c0b6..6102e7a 100644
--- a/src/kv_disk_cache.zig
+++ b/src/kv_disk_cache.zig
@@ -61,6 +61,16 @@ const io_util = @import("io_util.zig");
 const disk_writer = @import("kv_disk_writer.zig");
 const log = @import("log.zig");
 
+// KVH (local patch, not upstream): an entry id written into the SSD tier by another program
+// (the handoff proxy) while the server runs. HTTP threads only store the id here; the
+// inference thread, which owns the prefix cache, imports it at its next lookup (drainImport).
+// One slot: handoffs are serialised by the proxy. 0 = empty.
+pub var kvh_pending_import = std.atomic.Value(u64).init(0);
+
+pub fn kvhQueueImport(id: u64) void {
+    kvh_pending_import.store(id, .release);
+}
+
 const KVCache = transformer_mod.KVCache;
 
 /// Restoring from disk only happens when it beats the best RAM match by at
@@ -3184,6 +3194,37 @@ pub const DiskTier = struct {
         }
     }
 
+    /// KVH (local patch): import a queued entry id, if any (inference thread only).
+    pub fn drainImport(self: *DiskTier) void {
+        const id = kvh_pending_import.swap(0, .acq_rel);
+        if (id == 0) return;
+        const added = self.importEntry(id) catch |err| {
+            log.info("  [disk-cache] kvh import e{d} failed: {s}\n", .{ id, @errorName(err) });
+            return;
+        };
+        if (added) log.info("  [disk-cache] kvh import e{d}: indexed ({d} entries)\n", .{ id, self.entries.items.len });
+    }
+
+    /// KVH (local patch): index one entry another program wrote into `root` while the server
+    /// runs, exactly as `scan` indexes each entry at startup. False if it is already indexed.
+    pub fn importEntry(self: *DiskTier, id: u64) !bool {
+        for (self.entries.items) |e| if (e.id == id) return false;
+        const loaded = self.loadEntry(id) orelse return error.DiskCacheImportInvalid;
+        // only a real entry moves next_id past it (a bogus id must not inflate future ids)
+        if (id >= self.next_id) self.next_id = id + 1;
+        var e = loaded.e;
+        e.last_used = self.bump();
+        var seen = std.AutoHashMap(u64, void).init(self.allocator);
+        defer seen.deinit();
+        self.billChunksOnce(&e, &seen);
+        self.entries.append(self.allocator, e) catch |err| {
+            self.freeIndexEntryOwned(&e);
+            return err;
+        };
+        self.total_bytes += e.bytes;
+        return true;
+    }
+
     /// Re-bill a scanned entry's chunk files against the inodes already counted this scan: the
     /// first entry to see an inode pays for it.
     fn billChunksOnce(self: *DiskTier, e: *IndexEntry, seen: *std.AutoHashMap(u64, void)) void {
diff --git a/src/prefix_cache.zig b/src/prefix_cache.zig
