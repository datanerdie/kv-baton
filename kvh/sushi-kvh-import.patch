 src/kv_disk_cache.zig | 44 ++++++++++++++++++++++++++++++++++++++++++-
 src/prefix_cache.zig  |  3 +++
 src/server.zig        | 22 ++++++++++++++++++++++
 4 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/src/http_conn.zig b/src/http_conn.zig
