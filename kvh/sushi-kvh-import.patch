--- a/src/prefix_cache.zig
+++ b/src/prefix_cache.zig
@@ -20,6 +20,7 @@ const transformer_mod = @import("transformer.zig");
 const model_mod = @import("model.zig");
 const kv_quant = @import("kv_quant.zig");
 const kv_disk_cache = @import("kv_disk_cache.zig");
+pub const kvhQueueImport = kv_disk_cache.kvhQueueImport; // KVH (local patch)
 const io_util = @import("io_util.zig");
 const log = @import("log.zig");
 const restore_dump = @import("restore_dump.zig");
@@ -1205,6 +1206,8 @@ pub const HotPrefixCache = struct {
     ) !LookupResult {
         self.last_restored_used = null;
         self.last_restored_disk_id = null;
+        // KVH (local patch): index an entry queued by POST /v1/kvh/import before matching.
+        if (self.disk) |*d| d.drainImport();
         if (skip) {
             try target_cache.truncate(0, s);
             if (target_ssm_entries) |entries| resetSsmEntries(entries);
diff --git a/src/server.zig b/src/server.zig
index ef50c24..c695429 100644
--- a/src/server.zig
+++ b/src/server.zig
@@ -833,6 +833,7 @@ const ROUTE_PATHS = [_][]const u8{
     "/v1/chat/completions",
     "/v1/completions",
     "/v1/embeddings",
+    "/v1/kvh/import", // KVH (local patch)
     "/v1/load-model",
     "/v1/messages",
     "/v1/models",
@@ -2524,6 +2525,11 @@ fn handleConnection(
         const header_end = std.mem.indexOf(u8, request, "\r\n\r\n") orelse return;
         const body = request[header_end + 4 .. total_read];
         try handleResponses(allocator, stream, body, lm);
+    } else if (std.mem.eql(u8, method, "POST") and std.mem.eql(u8, path, "/v1/kvh/import")) {
+        // KVH (local patch): queue an SSD-tier entry id for import at the next prefix lookup.
+        const header_end = std.mem.indexOf(u8, request, "\r\n\r\n") orelse return;
+        const body = request[header_end + 4 .. total_read];
+        try handleKvhImport(allocator, stream, body);
     } else if (std.mem.eql(u8, method, "POST") and std.mem.eql(u8, path, "/tokenize")) {
         const header_end = std.mem.indexOf(u8, request, "\r\n\r\n") orelse return;
         const body = request[header_end + 4 .. total_read];
@@ -7875,6 +7881,23 @@ fn truncateEmbeddingDims(embedding: []f32, dims: usize) []f32 {
     return out;
 }
 
+fn handleKvhImport(allocator: std.mem.Allocator, stream: *Conn, body: []const u8) !void {
+    const parsed = std.json.parseFromSlice(std.json.Value, allocator, body, .{}) catch {
+        try sendErrorResponse(allocator, stream, "400 Bad Request", "invalid_request_error", "Invalid JSON", 400);
+        return;
+    };
+    defer parsed.deinit();
+    const id_v = if (parsed.value == .object) parsed.value.object.get("id") else null;
+    if (id_v == null or id_v.? != .integer or id_v.?.integer <= 0) {
+        try sendErrorResponse(allocator, stream, "400 Bad Request", "invalid_request_error", "'id' (a positive integer) is required", 400);
+        return;
+    }
+    prefix_cache_mod.kvhQueueImport(@intCast(id_v.?.integer));
+    var buf: [64]u8 = undefined;
+    const out = std.fmt.bufPrint(&buf, "{{\"queued\":{d}}}", .{id_v.?.integer}) catch "{}";
+    try sendResponse(stream, "200 OK", "application/json", out);
+}
+
 fn handleTokenize(
     allocator: std.mem.Allocator,
     stream: *Conn,
